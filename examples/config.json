{
  "image": "seu-vm-image",
  "install": [
    {
      "type": "mise",
      "toml": "./mise.toml"
    },
    {
      "type": "docker-compose",
      "compose": "local/docker-compose.yml"
    },
    {
      "type": "docker",
      "image": "postgres:18"
    },
    {
      "type": "maven",
      "artifact": "org.apache.maven.plugins:maven-failsafe-plugin:3.5.6"
    },
    {
      "type": "script",
      "script": "mvn clean install -DskipTests -T1C && mvn exec:java --file club/club-ui/club-ui-test/pom.xml -e -Dexec.mainClass=com.microsoft.playwright.CLI -Dexec.args=\"install-deps\""
    }
  ],
  "ports": [8080, "5173:5173"],
  "mounts": [
    { "host": "~/datasets", "guest": "/datasets", "readonly": true }
  ]
}
