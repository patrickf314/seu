#!/usr/bin/env bash
# seu -- run Claude Code on this project inside an isolated microsandbox VM.
set -euo pipefail
SEU_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
export SEU_ROOT

usage() {
  cat >&2 <<'USAGE'
seu -- Claude Code in a hardware-isolated microVM, with a full build toolchain

usage: seu <command> [options]

  doctor              check the host, the project profile and, if running, the VM
  build [options]     once per worktree: build the base image, fill every cache,
                      then open a shell
  start               boot the VM (locked-down network) and start dockerd
  stop                shut the VM down; /work and all caches persist
  shell               open a shell in the VM, starting it if needed
  status              show VM and toolchain state
  pull                fetch the VM's commits into this worktree as a git remote
  clean [--volumes]   remove the VM (and optionally its caches)

build options:
  --with-images       build the project's application images too, so that the
                      test compose file can come up (slow, lots of disk)
  --rebuild           force a base-image rebuild even if nothing changed
  --no-host-m2        do not mount ~/.m2/repository into the build sandbox;
                      download every artifact instead
  --no-host-images    do not reuse Docker images from the host daemon
  --refresh-images    re-export the host images even if nothing changed

The project describes itself in .seu/config.conf (image_name, mise_config,
maven_server, prepull). Without it, sensible defaults apply.

env:
  SEU_NET=session|build   egress profile for start/shell (default: session)
  SEU_MSB=<path>          microsandbox binary
  SEU_STATE_DIR=<path>    where bundles, pidfiles and staged images live
  SEU_HOST_M2=<path>      host Maven repository (default: ~/.m2/repository)
  SEU_USE_HOST_M2=0       same as --no-host-m2
  GITHUB_ACTOR / GITHUB_TOKEN
                          fallback artifact-repository credentials, `build` only

`build` reads your ~/.m2 and host Docker images; a SESSION never sees either.

The worktree is mounted READ-ONLY at /src and cloned to /work inside the VM.
Get work back out with `seu pull`.
USAGE
  exit 2
}

cmd="${1:-}"; [[ $# -gt 0 ]] && shift || true
case "$cmd" in
  doctor|build|start|stop|shell|status|pull|clean)
    # shellcheck source=/dev/null
    source "$SEU_ROOT/lib/cmd-$cmd.sh"; "cmd_$cmd" "$@" ;;
  -h|--help|help|"") usage ;;
  *) printf 'seu: unknown command %q\n\n' "$cmd" >&2; usage ;;
esac
